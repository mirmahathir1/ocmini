g emojis to files unless asked.\n","strict":false,"parameters":{"properties":{"content":{"description":"The content to write to the file","type":"string"},"filePath":{"description":"The absolute path to the file to write (must be absolute, not relative)","type":"string"}},"required":["content","filePath"],"type":"object"}}],"reasoning":{"effort":"xhigh","summary":"auto"}}}
